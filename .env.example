# HyperSync on Robinhood Chain needs an Envio API token.
# Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=<YOUR-API-TOKEN>

# RPC for the mint-time contract reads (agent id and name) and as HyperSync's
# fallback. Defaults to Robinhood's public endpoint, which is unreachable from
# some regions; an Alchemy URL works:
#   https://robinhood-mainnet.g.alchemy.com/v2/<key>
# ENVIO_ROBINHOOD_RPC_URL=

# Optional: where settlement webhooks go, and the secret they are signed with.
# Unset URL = no webhooks.
# ENVIO_KUDO_WEBHOOK_URL=https://kudo.example/api/indexer/webhook
# ENVIO_KUDO_WEBHOOK_SECRET=
